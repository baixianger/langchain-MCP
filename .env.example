# ============================================
# LangChain MCP - Environment Variables
# ============================================

# --------------------------------------------
# Server
# --------------------------------------------
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# --------------------------------------------
# Database
# --------------------------------------------
DB_PATH=./data/langchain.db
CHROMA_PATH=./data/chroma

# --------------------------------------------
# OAuth Providers
# --------------------------------------------
# GitHub OAuth (optional - IPv4 only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (recommended - supports IPv6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------
# AI / Embeddings
# --------------------------------------------
OPENROUTER_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
