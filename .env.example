# ======================
# Embedding Provider
# ======================
# ChromaDB: default, sentence-transformer, openai, cohere, jina, voyageai, ollama, google-genai, huggingface
# External: openrouter (default)
EMBEDDING_PROVIDER=openrouter

# Model name (optional, provider-specific defaults used if not set)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ======================
# Provider API Keys (only needed for selected provider)
# ======================
# OPENAI_API_KEY=sk-...
# COHERE_API_KEY=...
# JINA_API_KEY=...
# VOYAGEAI_API_KEY=...
# GOOGLE_API_KEY=...
# HUGGINGFACE_API_KEY=...
# OLLAMA_URL=http://localhost:11434

# OpenRouter (default provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=qwen/qwen3-embedding-8b

# ======================
# GitHub
# ======================
GITHUB_TOKEN=your_github_token_here

# ======================
# ChromaDB
# ======================
# Option 1: Local server
#   Start: chroma run --path ./data/chroma
#   Or Docker: docker run -p 8000:8000 chromadb/chroma
# CHROMA_URL=http://localhost:8000

# Option 2: Chroma Cloud (https://trychroma.com)
# CHROMA_CLOUD_HOST=api.trychroma.com
# CHROMA_CLOUD_TENANT=your-tenant-id
# CHROMA_CLOUD_DATABASE=your-database-name
# CHROMA_CLOUD_API_KEY=your-api-key
